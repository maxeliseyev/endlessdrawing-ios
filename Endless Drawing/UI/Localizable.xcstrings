{
  "sourceLanguage" : "en",
  "strings" : {
    "A drawing could not be stored locally. It is still in memory; retry before closing the app." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось записать рисунок на устройство. Он пока только в памяти; повторите запись до закрытия приложения."
          }
        }
      }
    },
    "Apple Pencil draws now; fingers move the canvas." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
